    {
        "id": "html_console_v2",
        "type": "template",
        "z": "al15_tab_v2",
        "name": "AL15 Console HTML",
        "field": "payload",
        "fieldType": "msg",
        "format": "html",
        "syntax": "mustache",
        "template": "<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>AL15 Engineering Console</title>\n<style>\n*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;background:#101010;color:#eee;font-family:Consolas,'Courier New',monospace}body{display:flex;flex-direction:column}header{padding:14px 20px;background:#181818;border-bottom:1px solid #333}.title{color:#00ff88;font-size:18px;font-weight:bold}.subtitle{color:#777;font-size:12px;margin-top:5px}#terminal{flex:1;padding:20px;overflow-y:auto;white-space:pre-wrap;line-height:1.45;font-size:14px}.command-area{display:flex;padding:14px 20px;border-top:1px solid #333;background:#151515}.prompt{color:#00ff88;font-weight:bold;margin-right:10px}#commandInput{flex:1;border:0;outline:0;background:transparent;color:white;font-family:inherit;font-size:14px}.error{color:#ff5555}.status{color:#888}\n</style>\n</head>\n<body>\n<header><div class=\"title\">AL15 Engineering Console</div><div class=\"subtitle\">Node-RED local shell</div></header>\n<div id=\"terminal\">AL15 Console ready.</div>\n<div class=\"command-area\"><span class=\"prompt\">AL15:~$</span><input id=\"commandInput\" autocomplete=\"off\" spellcheck=\"false\" autofocus></div>\n<script>\nconst input=document.getElementById('commandInput');\nconst terminal=document.getElementById('terminal');\nlet history=[];let pos=0;\nfunction line(text,cls){const e=document.createElement('div');if(cls)e.className=cls;e.textContent=text;terminal.appendChild(e);terminal.scrollTop=terminal.scrollHeight;}\nasync function run(cmd){\n if(cmd==='clear'){terminal.innerHTML='';return;}\n line('AL15:~$ '+cmd);\n try{\n  const r=await fetch('/console/exec',{method:'POST',headers:{'Content-Type':'text/plain;charset=UTF-8'},body:cmd});\n  const text=await r.text();\n  if(text)line(text,r.ok?'':'error');\n  if(!text)line('[completed]','status');\n }catch(e){line('ERROR: '+e.message,'error');}\n}\ninput.addEventListener('keydown',e=>{\n if(e.key==='Enter'){e.preventDefault();const c=input.value.trim();if(!c)return;history.push(c);pos=history.length;input.value='';run(c);}\n else if(e.key==='ArrowUp'){e.preventDefault();if(history.length){if(pos>0)pos--;input.value=history[pos]||'';}}\n else if(e.key==='ArrowDown'){e.preventDefault();if(pos<history.length-1){pos++;input.value=history[pos];}else{pos=history.length;input.value='';}}\n});\ndocument.addEventListener('click',()=>input.focus());\n</script>\n</body>\n</html>",
        "output": "str",
        "x": 380,
        "y": 100,
        "wires": [
