    {
        "id": "prepare_v2",
        "type": "function",
        "z": "al15_tab_v2",
        "name": "Prepare command",
        "func": "let command = msg.payload;\nif (Buffer.isBuffer(command)) command = command.toString('utf8');\ncommand = String(command || '').trim();\nif (!command) {\n    msg.statusCode = 400;\n    msg.payload = 'Empty command';\n    return [null,msg];\n}\n\n// Preserve HTTP request/response so we can answer later\nconst id = Date.now().toString() + Math.random().toString(16).slice(2);\nflow.set('cmd_' + id, {\n    req: msg.req,\n    res: msg.res,\n    stdout: '',\n    stderr: ''\n});\n\nmsg._cmdId = id;\nmsg.payload = command;\nreturn [msg,null];",
        "outputs": 2,
        "x": 390,
        "y": 260,
        "wires": [
            [
                "exec_v2"
            ],
            [
                "response_v2"
            ]
        ]
    },
    {
