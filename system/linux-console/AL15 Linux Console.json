    {
        "id": "finish_v2",
        "type": "function",
        "z": "al15_tab_v2",
        "name": "Build ONE response",
        "func": "const id = msg._cmdId;\nconst data = flow.get('cmd_' + id);\n\nif (!data) {\n    return null;\n}\n\nflow.set('cmd_' + id, undefined);\n\nmsg.req = data.req;\nmsg.res = data.res;\n\nlet output = '';\n\nif (data.stdout) output += data.stdout;\nif (data.stderr) {\n    if (output && !output.endsWith('\\n')) output += '\\n';\n    output += data.stderr;\n}\n\nmsg.payload = output;\nmsg.headers = {'Content-Type':'text/plain; charset=utf-8'};\n\nlet rc = 0;\nif (msg.payload && typeof msg.payload === 'object' && msg.payload.code !== undefined) {\n    rc = msg.payload.code;\n}\n\nmsg.statusCode = 200;\nreturn msg;",
        "outputs": 1,
