                "finish_v2"
            ]
        ]
    },
    {
        "id": "save_stdout_v2",
        "type": "function",
        "z": "al15_tab_v2",
        "name": "Collect stdout",
        "func": "const id = msg._cmdId;\nconst data = flow.get('cmd_' + id);\nif (data) {\n    data.stdout += String(msg.payload || '');\n    flow.set('cmd_' + id, data);\n}\nreturn null;",
        "outputs": 0,
        "x": 860,
        "y": 210,
        "wires": []
    },
    {
        "id": "save_stderr_v2",
        "type": "function",
        "z": "al15_tab_v2",
        "name": "Collect stderr",
        "func": "const id = msg._cmdId;\nconst data = flow.get('cmd_' + id);\nif (data) {\n    data.stderr += String(msg.payload || '');\n    flow.set('cmd_' + id, data);\n}\nreturn null;",
        "outputs": 0,
